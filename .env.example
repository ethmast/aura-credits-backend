# --- Server ---
# Port to listen on. Railway sets PORT itself; 8080 is the local default.
PORT=8080
# Directory holding the SQLite database (aura.db). On Railway, mount a
# volume and point DATA_DIR at the mount path so data survives deploys.
DATA_DIR=./data

# --- Google sign-in ---
# OAuth 2.0 *web* client ID for this project. Android sends Google ID
# tokens whose audience is this client ID; the backend verifies them
# against Google's JWKS. (The Android app also needs its own Android
# OAuth client registered with the app's SHA-1 fingerprint.)
GOOGLE_WEB_CLIENT_ID=

# --- Sessions ---
# HMAC secret for the backend's own session JWTs (HS256, 30-day expiry).
# Use a long random value. If unset, an ephemeral secret is generated at
# boot and all sessions die on restart.
SESSION_SECRET=

# --- Credits / money (all values are integer microdollars: $1 = 1000000) ---
# One-time grant for a brand-new account. 100000 = $0.10.
STARTER_GRANT_MICROS=100000
# Amount held before each /format call; the call is rejected unless the
# balance covers it. 5000 = $0.005.
FORMAT_RESERVE_MICROS=5000
# Charge per /format call when the provider does not report a cost.
# 1000 = $0.001.
FORMAT_FLAT_MICROS=1000
# Max settled+reserved spend per user per UTC day. 200000 = $0.20.
USER_DAILY_CAP_MICROS=200000
# Max settled+reserved spend across all users per UTC day. 2000000 = $2.00.
GLOBAL_DAILY_CAP_MICROS=2000000

# --- AI provider (server-side key; OpenAI-compatible) ---
# Base URL WITHOUT a trailing /chat/completions, e.g.
# https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_MODEL=

# --- Google Play purchase verification ---
# The Android package name of the app.
PLAY_PACKAGE_NAME=com.aura.verselink
# Full JSON of the Google Cloud service account that has access to the
# Play Console (via a Play Developer API user with "View financial data"
# / order permissions). Paste the entire JSON as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Map of Play product ID -> credits granted on purchase, in microdollars.
# Amounts come ONLY from here, never from the client.
# Example: {"credits_099":1000000,"credits_499":5000000} ($0.99 -> $1.00
# of credits, $4.99 -> $5.00 of credits).
PRODUCT_CREDITS_JSON={"credits_099":1000000}
